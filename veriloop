#!/usr/bin/env python3
"""VeriLoop — Unified CLI for the End-to-End Verifiable Autonomous Research Pipeline.

Subcommands:
  ./veriloop gate [args...]         Run dual-layer hard evidence gate (tools/verifiable_gate.py)
  ./veriloop claims [args...]       Manage pre-registered claim ledger G1-G7 (claims.py)
  ./veriloop board -w <ws>          Render interactive verifiable HTML research board
  ./veriloop demo                   Run 10-second zero-API closed-loop verification demo
  ./veriloop live [args...]         Run live LLM showcase (claude-haiku + codex-cli path-only XMR)
  ./veriloop install [args...]      Install VeriLoop skills into Claude Code / Codex CLI
  ./veriloop test                   Run all offline verification tests + skill catalog checks
  ./veriloop lint-paper [args...]   Run Best-Paper-Writing-Skill prose & figure checks
                                    (supports --draft <files...>, --tex <main.tex>,
                                     --layout one|two, --metrics <files...>, --exemplars [args...])
  ./veriloop audit-paper [--no-lint]
                                    4-in-1 self-audit of paper/ (trace_numbers + citation_audit
                                    + bestpaper check_draft + check_figures)
  ./veriloop verify-cites <doc> --bib <refs.bib> [--online] [--check-claims]
                                    Hard literature verification gate (arXiv / Crossref / Semantic Scholar)
  ./veriloop fetch-bib <id_or_query...> [--append-to refs.bib]
                                    Fetch canonical BibTeX directly from arXiv / Crossref / S2 APIs
  ./veriloop bind --inputs <runs...> [--out-dir paper/bound]
                                    Auto-bind TensorBoard / W&B / CSV logs -> LaTeX macros, Booktabs & Okabe-Ito PDFs
  ./veriloop review-ui --report <files...> --logs <logs...> [--serve] [--out review.html]
                                    Interactive split-pane Web review UI linking manuscript numbers/cites to raw logs/code
  ./veriloop audit-pdf <main.pdf> [--max-main-pages 8] [--logs ...] [--render-dir ...]
                                    Per-page PDF layout, Type-3 font, anonymity, visual margin & expanded-macro audit
  ./veriloop gpu-showcase [--skip-train]
                                    Run the real PyTorch GPU Fashion-MNIST -> paper-bind -> 8-page PDF -> gate showcase
  ./veriloop ingest -w <ws> [--arxiv ID...] [--repo URL_OR_DIR]
                                    Ingest arXiv LaTeX sources & index baseline repo via AST -> Formula<->Code map
  ./veriloop sandbox -w <ws> [--mode local|docker] --cmd "..."
                                    Run experiments locally or in an isolated GPU Docker container with NaN/OOM watchdog
  ./veriloop research -w <ws> --level 1|2 [--idea "..."] [--papers ID...]
                                    Unified Level-1/Level-2 crash-resumable research pipeline with hard evidence gates
  ./veriloop studio -w <ws> [--port 8765] [--export-html out.html]
                                    Launch VeriLoop Studio local Web cockpit (Launcher + Live Monitor + Audit Workbench)
  ./veriloop milestone-audit [args...]
                                    Independent dual-model milestone audit (latest Claude + latest
                                    Gemini in parallel on SHA-256 frozen artifacts -> action plan)
  ./veriloop eval-v2 <subcmd> [args...]
                                    Reproduce v2 zero-override benchmark from committed artifacts:
                                      summary       aggregate committed v2 JSONLs (zero overrides)
                                      layer1        re-run deterministic Layer-1 gate on 16 frozen workspaces
                                      run           run/resume paired 2x2 factorial reviewer benchmark
                                      unseen        run 21-scenario unseen blind test (SHA-256 locked by default)
                                      rebuild-paper regenerate paper/out/ tables & figures from v2 JSONLs
"""
import argparse
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent
RL_SCRIPTS = ROOT / "skills/research-loop/scripts"
BP_SCRIPTS = ROOT / "skills/bestpaper-writing/scripts"
MDA_SCRIPT = ROOT / "skills/milestone-dual-audit/scripts/milestone_dual_audit.py"


def passthrough(cmd):
    p = subprocess.run(cmd)
    sys.exit(p.returncode)


def run_lint_paper(rest):
    if rest and rest[0] == "--exemplars":
        passthrough([sys.executable, str(BP_SCRIPTS / "find_exemplars.py"), *rest[1:]])
    if rest and rest[0] == "--metrics":
        targets = rest[1:] or [
            str(ROOT / "paper/sec/0_abstract.tex"),
            str(ROOT / "paper/sec/1_intro.tex"),
        ]
        passthrough([sys.executable, str(BP_SCRIPTS / "style_metrics.py"), *targets])

    ap = argparse.ArgumentParser(prog="veriloop lint-paper")
    ap.add_argument(
        "--draft",
        nargs="+",
        default=[
            str(ROOT / "paper/sec/0_abstract.tex"),
            str(ROOT / "paper/sec/1_intro.tex"),
        ],
        help="Draft .tex/.md files for check_draft.py (default: abstract + intro)",
    )
    ap.add_argument(
        "--tex",
        default=str(ROOT / "paper/main_icml2027.tex"),
        help="Main .tex file for check_figures.py (pass 'none' to skip)",
    )
    ap.add_argument(
        "--layout",
        choices=("one", "two"),
        default="two",
        help="Paper column layout for check_figures.py",
    )
    args = ap.parse_args(rest)

    r1 = subprocess.run([sys.executable, str(BP_SCRIPTS / "check_draft.py"), *args.draft])
    r2_rc = 0
    if args.tex.lower() != "none" and Path(args.tex).exists():
        r2 = subprocess.run(
            [sys.executable, str(BP_SCRIPTS / "check_figures.py"), args.tex, "--layout", args.layout]
        )
        r2_rc = r2.returncode
    return 0 if (r1.returncode == 0 and r2_rc == 0) else 1


def run_eval_v2(rest):
    usage = (
        "Usage: ./veriloop eval-v2 <summary|layer1|run|unseen|rebuild-paper> [args...]\n"
        "  summary        Aggregate committed v2 frozen JSONLs with zero overrides\n"
        "  layer1         Run deterministic Layer-1 gate across the 16 frozen workspaces\n"
        "  run            Run or resume the paired 2x2 factorial LLM benchmark (supports --dry-run)\n"
        "  unseen         Run the 21-scenario unseen SciIntegrity blind test (supports --dry-run)\n"
        "  rebuild-paper  Rebuild paper/out/ stats, LaTeX tables, and vector figures from v2 JSONLs"
    )
    if not rest or rest[0] in ("-h", "--help", "help"):
        print(usage)
        sys.exit(0)
    action, extra = rest[0], rest[1:]
    v2_dir = ROOT / "eval/v2_frozen"
    if action == "summary":
        targets = extra or [
            str(v2_dir / "results_layer1.jsonl"),
            str(v2_dir / "results_factorial_v2.jsonl"),
        ]
        passthrough([sys.executable, str(v2_dir / "aggregate_v2.py"), *targets])
    elif action == "layer1":
        passthrough([sys.executable, str(v2_dir / "run_v2_factorial.py"), "--layer1-only", *extra])
    elif action == "run":
        passthrough([sys.executable, str(v2_dir / "run_v2_factorial.py"), *extra])
    elif action == "unseen":
        passthrough([sys.executable, str(ROOT / "eval/v2_unseen/run_unseen_mech_blind.py"), *extra])
    elif action == "rebuild-paper":
        passthrough([sys.executable, str(ROOT / "paper/build_tables_and_figures.py"), *extra])
    else:
        print(f"Unknown eval-v2 subcommand: {action}\n\n{usage}", file=sys.stderr)
        sys.exit(2)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        sys.exit(0)

    sub, rest = sys.argv[1], sys.argv[2:]
    if sub == "gate":
        passthrough([sys.executable, str(ROOT / "tools/verifiable_gate.py"), *rest])
    elif sub == "claims":
        passthrough([sys.executable, str(RL_SCRIPTS / "claims.py"), *rest])
    elif sub == "board":
        passthrough([sys.executable, str(RL_SCRIPTS / "render_board.py"), *rest])
    elif sub == "demo":
        passthrough(["bash", str(ROOT / "examples/veriloop-walkthrough/run_walkthrough.sh"), *rest])
    elif sub == "live":
        passthrough([sys.executable, str(ROOT / "examples/live-showcase/run_live_showcase.py"), *rest])
    elif sub == "install":
        passthrough(["bash", str(ROOT / "tools/install_veriloop.sh"), *rest])
    elif sub == "test":
        r1 = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", str(ROOT / "tests/verifiable"), "-v"])
        r2 = subprocess.run([sys.executable, "-m", "unittest", "tests/test_skill_groups.py", "-v"], cwd=str(ROOT))
        sys.exit(0 if (r1.returncode == 0 and r2.returncode == 0) else 1)
    elif sub == "lint-paper":
        sys.exit(run_lint_paper(rest))
    elif sub == "milestone-audit":
        passthrough([sys.executable, str(MDA_SCRIPT), *rest])
    elif sub == "verify-cites":
        passthrough([sys.executable, str(RL_SCRIPTS / "citation_audit.py"), *rest])
    elif sub == "fetch-bib":
        passthrough([sys.executable, str(RL_SCRIPTS / "citation_audit.py"), "--fetch-bib", *rest])
    elif sub == "bind":
        passthrough([sys.executable, str(ROOT / "tools/paper_bind.py"), *rest])
    elif sub == "review-ui":
        passthrough([sys.executable, str(ROOT / "tools/review_ui.py"), *rest])
    elif sub == "audit-pdf":
        passthrough([sys.executable, str(ROOT / "tools/pdf_audit.py"), *rest])
    elif sub == "gpu-showcase":
        passthrough(["bash", str(ROOT / "examples/gpu-dl-benchmark/run_end_to_end.sh"), *rest])
    elif sub == "ingest":
        passthrough([sys.executable, str(ROOT / "tools/paper_ingest.py"), *rest])
    elif sub == "sandbox":
        passthrough([sys.executable, str(ROOT / "tools/sandbox_runner.py"), *rest])
    elif sub == "research":
        passthrough([sys.executable, str(ROOT / "tools/research_orchestrator.py"), *rest])
    elif sub == "studio":
        passthrough([sys.executable, str(ROOT / "tools/studio_server.py"), *rest])
    elif sub == "eval-v2":
        run_eval_v2(rest)
    elif sub == "audit-paper":
        no_lint = "--no-lint" in rest
        sec_dir = ROOT / "paper/sec"
        order = [
            "0_abstract.tex", "1_intro.tex", "2_method.tex", "3_experiments.tex",
            "4_discussion.tex", "5_related.tex", "6_conclusion.tex", "7_statements.tex", "appendix.tex",
        ]
        combined = "\n".join((sec_dir / f).read_text(encoding="utf-8") for f in order if (sec_dir / f).exists())
        with tempfile.NamedTemporaryFile("w", suffix=".tex", delete=False) as tf:
            tf.write(combined)
            tmp_path = tf.name
        try:
            audit_flags = ["--logs", str(ROOT / "paper/out/stats_summary.txt")]
            gpu_summary = ROOT / "examples/gpu-overnight-research/out/overnight_summary.txt"
            if gpu_summary.is_file():
                audit_flags.extend(["--logs", str(gpu_summary)])
            r1 = subprocess.run([sys.executable, str(RL_SCRIPTS / "trace_numbers.py"), tmp_path, *audit_flags])
            r2 = subprocess.run([sys.executable, str(RL_SCRIPTS / "citation_audit.py"), tmp_path, "--bib", str(ROOT / "paper/refs.bib")])
            r3_rc = 0 if no_lint else run_lint_paper([])
            sys.exit(0 if (r1.returncode == 0 and r2.returncode == 0 and r3_rc == 0) else 1)
        finally:
            Path(tmp_path).unlink(missing_ok=True)
    else:
        print(f"Unknown subcommand: {sub}\n\n" + __doc__.strip(), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
